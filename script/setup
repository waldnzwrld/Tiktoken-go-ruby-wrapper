# bin/bash

# This script is used to setup dependencies for the gem

# Ensure go is installed
if ! [ -x "$(command -v go)" ]; then
  echo 'Error: go is not installed.' >&2
  exit 1
fi

# install go dependencies
echo "Installing go dependencies...\n"
go mod download go-deps/go.mod

# Build C libraries from go file
echo "Building C libraries...\n"
go build -buildmode=c-shared -o tiktoken-wrapper/ext/tiktoken-wrapper/libttwrapper.so go-deps/tiktoken_wrapper.go
