# !/bin/bash
# if the vendor directory does not exist, run script/setup

if [ ! -d "vendor" ]; then
  echo 'Running script/setup...\n'
  script/setup
fi

script/build-clib


echo "Running benchmarks"
result=$(ruby -e 'require "./test/benchmark/benchmark_test.rb"; puts BenchmarkTest.new.performance_test')
echo $result
