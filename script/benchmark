# bin/bash
# if the vendor directory does not exist, run script/setup

if [ ! -d "vendor" ]; then
  echo 'Running script/setup...\n'
  script/setup
fi

# store git head sha as a var
current=$(git rev-parse HEAD)
echo $current
# if the sha of the tiktoken_wrapper.go file OR the tiktoken-encoder/ext/tiktoken-encoder/libttwrapper.so file does not match git HEAD sha, run script/build-clib
if [ ! "$(current)"  = "$(git rev-parse tiktoken-encoder/ext/tiktoken-encoder/libttwrapper.so)" ] || [ ! "$(current)" = "$(git rev-parse HEAD:tiktoken_wrapper.go)" ]; then
  echo 'Building C libraries...\n'
  script/build-clib
fi

# if pprof is not installed, install it
if ! [ -x "$(command -v pprof)" ]; then
  echo 'Installing pprof...\n'
  go install github.com/google/pprof@latest
fi

ruby test/benchmark/benchmark_test.rb
pprof -http=localhost:6600 mem.pprof
